# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Event --------------------------------------------------------------------
DX_EVENT_CODE=designathon-x
NEXT_PUBLIC_APP_URL=https://designathon-x.vercel.app

# --- Credential secrets (generate each with: openssl rand -base64 32) ---------
# HMAC key for PIN uniqueness fingerprints. Keep stable for the whole event.
DX_PIN_PEPPER=
# AES-256-GCM key for temporary printable credential packages.
DX_VAULT_KEY=
# Bearer secret Vercel Cron sends to /api/cron/maintenance
CRON_SECRET=

# --- Tests (real PostgreSQL 15+) ----------------------------------------------
DX_TEST_PG=postgres://postgres@127.0.0.1:54329/postgres
